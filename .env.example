NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Calendar (opcional). El mismo cliente OAuth del login con Google sirve:
# activa la API de Google Calendar y añade la URI de retorno <origen>/api/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cifra los tokens de Google guardados en la base: openssl rand -base64 32
GOOGLE_TOKEN_KEY=
# Origen público fijo de la app en producción (p. ej. https://app.tudominio.com). En local puede quedar vacío.
APP_URL=

# OpenRouter (agentes de la oficina). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Gratuitos en orden de preferencia (si uno falla, se usa el siguiente). Lista en openrouter.ai/models.
OPENROUTER_MODELOS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free

# Groq (console.groq.com, plan gratuito): primer proveedor de los agentes; si falla o se acaba su cuota,
# siguen OpenRouter y Gemini. Opcional: GROQ_MODELOS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b
GROQ_API_KEY=

# Google AI Studio (aistudio.google.com, plan gratuito sin facturación): respaldo de los agentes cuando
# OpenRouter no responde o se acaba su cuota. Opcional: GEMINI_MODELOS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_API_KEY=

# Avisos por Telegram (opcional). Crea el bot con @BotFather y guarda su token SOLO en Vault de Supabase
# (ver supabase/migrations/20261029200000_avisos_telegram.sql). Aquí: su nombre de usuario (sin @) y el
# secreto del webhook, igual al de Vault `telegram_webhook_secreto` (openssl rand -hex 32).
TELEGRAM_BOT_USUARIO=
TELEGRAM_WEBHOOK_SECRETO=

# Formulario de la página pública: secreto que exige la RPC enviar_solicitud_web, igual al de
# Vault `formulario_secreto` (openssl rand -hex 32). También firma la huella de la IP para limitar envíos.
FORMULARIO_SECRETO=
